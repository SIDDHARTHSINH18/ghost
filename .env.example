NVIDIA_API_KEY=your_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Resource limits (optional; defaults shown) ---
# Maximum size of one uploaded file, in megabytes
GHOST_MAX_UPLOAD_MB=50
# Aggregate cap across all uploaded documents, in megabytes
GHOST_MAX_TOTAL_STORAGE_MB=500
# Uploadable file types (comma-separated)
GHOST_ALLOWED_EXTENSIONS=.pdf,.docx,.txt
